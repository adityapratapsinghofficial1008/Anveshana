# Server environment configuration example
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/anveshana

# Client origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Rate limit
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=5

# Email delivery (Brevo HTTPS API - recommended for Render & production)
BREVO_API_KEY=

# Optional fallback SMTP (for local development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
SMTP_FROM=Anveshana <theheroadityasingh498@gmail.com>

